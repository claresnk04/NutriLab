# Salin menjadi .env.local lalu isi dari Firebase Console > Project settings > Web app.
# Saat VITE_USE_EMULATORS=true, nilai di bawah boleh dummy (emulator tidak memvalidasi API key).
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-nutri-lab.firebaseapp.com
# "demo-nutri-lab" harus sama dengan --project pada script `npm run emulators`.
# Ganti ke project ID sungguhan (mis. nutri-lab-dev) saat tidak memakai emulator.
VITE_FIREBASE_PROJECT_ID=demo-nutri-lab
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000

# reCAPTCHA Enterprise site key untuk Firebase App Check (kosongkan saat pengembangan lokal).
VITE_APPCHECK_SITE_KEY=
# Gemini API (Google AI Studio). Kosongkan untuk memakai fallback berikutnya.
# Buat key di https://aistudio.google.com/apikey lalu batasi ke domain hosting Anda.
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-3.5-flash-lite

# Groq Vision API (Tier 2 Fallback). Kosongkan untuk langsung fallback ke PaddleOCR lokal.
# Buat key di https://console.groq.com/keys
VITE_GROQ_API_KEY=
VITE_GROQ_MODEL=qwen/qwen3.8-27b

# true = sambungkan ke Firebase Emulator Suite lokal.
VITE_USE_EMULATORS=true

# Basis URL layanan ekstraksi. Default "/api" (proxy Vite saat dev, rewrite Hosting saat produksi).
VITE_API_BASE_URL=/api
