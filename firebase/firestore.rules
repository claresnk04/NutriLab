rules_version = '2';

// Aturan keamanan Nutri-lab (setup awal).
// Pemetaan koleksi dari PRD v1.1 bagian 11:
//   users/{uid}                      -> dokumen akun minimal
//   users/{uid}/profiles/{id}        -> profil berversi (berlaku_sejak)
//   users/{uid}/consents/{id}        -> versi + waktu persetujuan (F01-4)
//   users/{uid}/entries/{id}         -> entri (snapshot nilai label, hapus lunak)
//   users/{uid}/daily_aggregates/{d} -> agregat harian turunan
//   config_parameters/{id}, config_versions/{v} -> parameter algoritma berversi (baca saja)
//   audit_log/{id}                   -> hanya server/admin
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasOnly(keys) {
      return request.resource.data.keys().hasOnly(keys);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && hasOnly(['profile', 'diubahPada']);
      allow delete: if isOwner(uid);

      match /profiles/{profileId} {
        allow read, write, delete: if isOwner(uid);
      }

      match /consents/{consentId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && hasOnly(['versi', 'disetujuiPada']);
        allow update: if false;
      }

      match /entries/{entryId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && hasOnly([
          'uid', 'namaProduk', 'jenisProduk', 'basisTabel', 'nilaiLabel', 'nSajian', 'status',
          'waktuMakan', 'zonaWaktu', 'dikonfirmasiPengguna', 'hasilSnapshot', 'configVersion',
          'dibuatPada', 'diubahPada', 'dihapusPada'
        ]);
      }

      match /daily_aggregates/{day} {
        allow read: if isOwner(uid);
        allow write, delete: if false;
      }
    }

    // Parameter algoritma: dapat dibaca pengguna login, tulis hanya lewat Admin SDK / dashboard admin.
    match /config_parameters/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /config_versions/{version} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Selain yang didefinisikan di atas (termasuk audit_log), akses klien ditolak.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
