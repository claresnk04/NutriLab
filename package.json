{
  "name": "nutri-lab",
  "private": true,
  "version": "1.0.0",
  "description": "NutriLab - aplikasi edukasi dan pemeriksaan kecocokan gizi",
  "author": "NutriLab",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "firebase"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "dev:frontend": "vite",
    "build": "npm run build -w packages/scoring && npm run build -w apps/web",
    "build:frontend": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "emulators": "firebase emulators:start --config firebase/firebase.json --project demo-nutri-lab --only auth,firestore",
    "test:rules": "firebase emulators:exec --config firebase/firebase.json --project demo-nutri-lab --only firestore \"npm run test:rules -w firebase\""
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.12.0",
    "lucide-react": "^0.462.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3",
    "vite": "^8.3.6"
  }
}
